# ============================================================================
# EventFlow Environment Variables Template
# Copy this file to .env.local for local development
# ============================================================================

# Vite Frontend Configuration
VITE_APP_NAME="EventFlow"
VITE_APP_ENV="development"

# Supabase Public Client Credentials (Safe for client-side bundle)
# Obtain these from your Supabase Project Settings -> API
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# Supabase Edge Functions / Backend Private Keys (NEVER expose to frontend)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-private-key"
SUPABASE_DB_PASSWORD="your-secure-database-password"
